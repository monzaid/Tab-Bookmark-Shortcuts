{"manifest_version": 3, "name": "Tab Bookmark Shortcuts", "version": "1.0.0", "description": "Save and switch tabs across windows with 10 configurable slots", "incognito": "not_allowed", "permissions": ["tabs", "windows", "storage", "notifications", "commands", "sidePanel", "scripting"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "commands": {"save-slot-1": {"description": "Save current tab to slot 1"}, "switch-slot-1": {"description": "Switch to slot 1"}, "save-slot-2": {"description": "Save current tab to slot 2"}, "switch-slot-2": {"description": "Switch to slot 2"}, "save-slot-3": {"description": "Save current tab to slot 3"}, "switch-slot-3": {"description": "Switch to slot 3"}, "save-slot-4": {"description": "Save current tab to slot 4"}, "switch-slot-4": {"description": "Switch to slot 4"}, "save-slot-5": {"description": "Save current tab to slot 5"}, "switch-slot-5": {"description": "Switch to slot 5"}, "save-slot-6": {"description": "Save current tab to slot 6"}, "switch-slot-6": {"description": "Switch to slot 6"}, "save-slot-7": {"description": "Save current tab to slot 7"}, "switch-slot-7": {"description": "Switch to slot 7"}, "save-slot-8": {"description": "Save current tab to slot 8"}, "switch-slot-8": {"description": "Switch to slot 8"}, "save-slot-9": {"description": "Save current tab to slot 9"}, "switch-slot-9": {"description": "Switch to slot 9"}, "save-slot-10": {"description": "Save current tab to slot 10"}, "switch-slot-10": {"description": "Switch to slot 10"}, "next-match": {"description": "Switch to next matching tab"}}, "action": {"default_title": "Tab Bookmark Shortcuts"}, "side_panel": {"default_path": "src/ui/sidebar/index.html"}}